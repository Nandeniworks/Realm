# Railway / Backend Production Environment Variables Template

# Port provided automatically by Railway (or fallback to 5001 locally)
PORT=5001

# Database Connection (MongoDB Atlas or Railway MongoDB Plugin)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/realm?retryWrites=true&w=majority

# Secrets for JWT Authentication
JWT_SECRET=realm_jwt_access_secret_key_2026_xYz
JWT_REFRESH_SECRET=realm_jwt_refresh_secret_key_2026_AbC

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CORS_ORIGIN=https://realm-delta.vercel.app,http://localhost:5173
